@model OldSchoolLab.Pages.Records.IndexModel
@if (Model.CanWhatsApp)
{
<div id="waWorkspace" class="modal fade" tabindex="-1" aria-labelledby="waModalTitle" aria-hidden="true" data-endpoint="@Url.Page("/Records/Index")">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div><h2 class="modal-title fs-5" id="waModalTitle">WhatsApp masivo</h2><div id="waProgress" class="small text-muted mt-1" aria-live="polite">Selecciona los contactos del listado</div></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="waToken" class="d-none">@Html.AntiForgeryToken()</form>
                <div id="waFeedback" role="status" class="small mb-3" aria-live="polite"></div>
                <div class="row g-3">
                    <div class="col-lg-5">
                        <h3 class="fs-6">Contactos seleccionados <span id="waListCount" class="badge text-bg-light">0</span></h3>
                        <div id="waContacts" class="list-group overflow-auto" style="max-height:420px" aria-label="Contactos de esta selección"></div>
                    </div>
                    <div class="col-lg-7">
                        <div id="waCurrentPanel" class="border rounded bg-light p-3 mb-3" hidden>
                            <div class="small text-muted">Contacto actual</div><div id="waCurrent" class="fw-semibold mt-1"></div>
                        </div>
                        <label for="waMessage" class="form-label fw-semibold">Mensaje para todos</label>
                        <textarea id="waMessage" class="form-control" rows="6" maxlength="2000" placeholder="Escribe el mensaje que enviarás…"></textarea>
                        <button id="waSaveMessage" type="button" class="btn btn-sm btn-link px-0 mt-1">Guardar mensaje para después</button>
                        <p class="small text-muted mt-2">Abre WhatsApp, envía manualmente y vuelve a este modal. Pulsa «Enviado y siguiente» para guardar la reactivación y abrir el próximo número.</p>
                        <details id="waHistory" class="mt-3" hidden><summary class="small fw-semibold">Historial</summary><div id="waHistoryBody" class="mt-2 small"></div></details>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-between gap-2">
                <div class="d-flex gap-2 flex-wrap">
                    <button id="waConfirm" type="button" class="btn btn-success">Comenzar envíos</button>
                    <button id="waOpen" type="button" class="btn btn-outline-success" hidden>Abrir WhatsApp</button>
                    <button id="waSent" type="button" class="btn btn-success" hidden>Enviado y siguiente</button>
                    <button id="waSkip" type="button" class="btn btn-outline-secondary" hidden>Omitir</button>
                    <button id="waPause" type="button" class="btn btn-outline-secondary" hidden>Pausar</button>
                    <button id="waContinue" type="button" class="btn btn-primary" hidden>Continuar envíos</button>
                </div>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
<script src="~/js/records-whatsapp.js" asp-append-version="true" defer></script>
}
