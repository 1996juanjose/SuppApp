@page "{id:int}"
@model OldSchoolLab.Pages.Records.EditModel
@using System.Text.Json
@{
    ViewData["Title"] = "Editar registro";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Editar registro</h1>
    <a asp-page="/Records/Index" class="btn btn-outline-secondary">Volver</a>
</div>

<form method="post" class="card shadow-sm">
    <input asp-for="Input.Id" type="hidden" />
    <input asp-for="Input.PaidAmount" type="hidden" id="paidAmount" />
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        @if (TempData["WarningMessage"] is string warningMessage)
        {
            <div class="alert alert-warning">@warningMessage</div>
        }

        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Input.StatusCatalogId" class="form-label"></label>
                <select asp-for="Input.StatusCatalogId" asp-items="Model.StatusOptions" class="form-select">
                    <option value="">Seleccione</option>
                </select>
                <span asp-validation-for="Input.StatusCatalogId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Input.RecordDate" class="form-label"></label>
                <input asp-for="Input.RecordDate" class="form-control" />
                <span asp-validation-for="Input.RecordDate" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Input.Cellphone" class="form-label"></label>
                <input asp-for="Input.Cellphone" class="form-control" />
                <span asp-validation-for="Input.Cellphone" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Input.Dni" class="form-label"></label>
                <input asp-for="Input.Dni" class="form-control" />
                <span asp-validation-for="Input.Dni" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.NameOrReference" class="form-label"></label>
                <input asp-for="Input.NameOrReference" class="form-control" />
                <span asp-validation-for="Input.NameOrReference" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.CallActivity" class="form-label"></label>
                <input asp-for="Input.CallActivity" class="form-control" />
                <span asp-validation-for="Input.CallActivity" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.ProductId" class="form-label"></label>
                <select asp-for="Input.ProductId" asp-items="Model.ProductOptions" class="form-select" id="productId">
                    <option value="">Sin producto</option>
                </select>
                <span asp-validation-for="Input.ProductId" class="text-danger"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="Input.Quantity" class="form-label"></label>
                <select asp-for="Input.Quantity" class="form-select" id="quantity" data-current="@Model.Input.Quantity">
                    <option value="">Seleccione producto</option>
                </select>
                <span asp-validation-for="Input.Quantity" class="text-danger"></span>
                <div class="form-text text-danger d-none" id="stockWarning"></div>
            </div>
            <div class="col-md-3">
                <label asp-for="Input.FolderPath" class="form-label"></label>
                <input asp-for="Input.FolderPath" class="form-control" />
                <span asp-validation-for="Input.FolderPath" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Destino" class="form-label"></label>
                <input asp-for="Input.Destino" class="form-control" list="destinosList" autocomplete="off" placeholder="Buscar o escribir destino..." />
                <datalist id="destinosList">
                    @foreach (var d in OldSchoolLab.Services.DestinosCatalog.Destinos)
                    {
                        <option value="@d"></option>
                    }
                </datalist>
                <span asp-validation-for="Input.Destino" class="text-danger"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="Input.Clave" class="form-label"></label>
                <input asp-for="Input.Clave" class="form-control" />
                <span asp-validation-for="Input.Clave" class="text-danger"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="Input.Guia" class="form-label"></label>
                <input asp-for="Input.Guia" class="form-control" />
                <span asp-validation-for="Input.Guia" class="text-danger"></span>
            </div>
        </div>

        <div class="row mt-4 g-3">
            <div class="col-md-4">
                <div class="border rounded p-3 bg-light">
                    <div class="text-muted small">Valor producto</div>
                    <div class="fs-4 fw-semibold" id="productAmount">S/ 0.00</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="border rounded p-3 bg-light">
                    <div class="text-muted small">Comisión</div>
                    <div class="fs-4 fw-semibold" id="commissionPreview">S/ 0.00</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="border rounded p-3 bg-light">
                    <div class="text-muted small">Costo compra</div>
                    <div class="fs-4 fw-semibold" id="costPreview">S/ 0.00</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="border rounded p-3 bg-light">
                    <div class="text-muted small">Stock disponible</div>
                    <div class="fs-4 fw-semibold" id="stockPreview">0</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="border rounded p-3 bg-light">
                    <div class="text-muted small">Pagado</div>
                    <div class="fs-4 fw-semibold" id="paidPreview">S/ 0.00</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="border rounded p-3 bg-light">
                    <div class="text-muted small">Debe</div>
                    <div class="fs-4 fw-semibold text-danger" id="balanceDue">S/ 0.00</div>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-page="/Records/Index" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </div>
</form>

<div class="row mt-4 g-4">
    <div class="col-lg-4">
        <form method="post" asp-page-handler="AddPayment" asp-route-id="@Model.Input.Id" enctype="multipart/form-data" class="card shadow-sm">
            <div class="card-header">
                <strong>Agregar pago</strong>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="PaymentInput.Amount" class="form-label"></label>
                    <input asp-for="PaymentInput.Amount" class="form-control" min="0.01" step="0.01" />
                    <span asp-validation-for="PaymentInput.Amount" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="PaymentProofFile" class="form-label">Comprobante</label>
                    <input asp-for="PaymentProofFile" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    <div class="form-text">Opcional. Máximo 1 MB. La fecha del pago se registra automáticamente.</div>
                    <span asp-validation-for="PaymentProofFile" class="text-danger"></span>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end">
                <button type="submit" class="btn btn-success">Agregar pago</button>
            </div>
        </form>
    </div>
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Historial de pagos</strong>
                <span class="badge text-bg-secondary">@Model.Payments.Count pago(s)</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha pago</th>
                                <th>Registrado</th>
                                <th>Cod. operación</th>
                                <th>Monto</th>
                                <th>Estado</th>
                                <th>Usuario</th>
                                <th>Comprobante</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model.Payments.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">No hay pagos registrados.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var payment in Model.Payments)
                            {
                                <tr>
                                    <td>@payment.PaymentDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>@payment.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@(string.IsNullOrWhiteSpace(payment.OperationNumber) ? "-" : payment.OperationNumber)</td>
                                    <td>@($"S/ {payment.Amount:0.00}")</td>
                                    <td>
                                        @if (payment.IsReversed)
                                        {
                                            <div>
                                                <span class="badge text-bg-danger">Extornado</span>
                                                <div class="small text-muted mt-1">@payment.ReversedByUserName @payment.ReversedAt?.ToString("yyyy-MM-dd HH:mm")</div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-success">Activo</span>
                                        }
                                    </td>
                                    <td>@payment.CreatedByUserName</td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(payment.ProofImagePath))
                                        {
                                            <span class="text-muted">Sin comprobante</span>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary btn-proof-preview"
                                                    data-url="@payment.ProofImagePath">
                                                Ver
                                            </button>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (!payment.IsReversed)
                                        {
                                            <form method="post" asp-page-handler="ReversePayment" asp-route-id="@Model.Input.Id" asp-route-paymentId="@payment.Id" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Extornar este pago?');">Extornar</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="paymentProofModal" tabindex="-1" aria-labelledby="paymentProofModalLabel" aria-hidden="true" data-bs-keyboard="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="paymentProofModalLabel">Comprobante</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="paymentProofPreview" src="" alt="Comprobante" class="img-fluid rounded" />
            </div>
            <div class="modal-footer">
                <a id="paymentProofOpenLink" href="#" target="_blank" rel="noopener" class="btn btn-outline-secondary">Abrir en pestaña</a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const priceLookup = @Html.Raw(JsonSerializer.Serialize(Model.ProductPriceLookup));
        const commissionLookup = @Html.Raw(JsonSerializer.Serialize(Model.ProductCommissionLookup));
        const costLookup = @Html.Raw(JsonSerializer.Serialize(Model.ProductPurchaseCostLookup));
        const stockLookup = @Html.Raw(JsonSerializer.Serialize(Model.ProductStockLookup));
        const productId = document.getElementById('productId');
        const quantity = document.getElementById('quantity');
        const paidAmount = document.getElementById('paidAmount');
        const productAmount = document.getElementById('productAmount');
        const commissionPreview = document.getElementById('commissionPreview');
        const costPreview = document.getElementById('costPreview');
        const stockPreview = document.getElementById('stockPreview');
        const paidPreview = document.getElementById('paidPreview');
        const balanceDue = document.getElementById('balanceDue');
        const stockWarning = document.getElementById('stockWarning');
        const initialQuantity = quantity.dataset.current;

        function formatCurrency(value) {
            return `S/ ${Number(value || 0).toFixed(2)}`;
        }

        function parseDecimal(value) {
            return Number.parseFloat((value ?? '0').toString().replace(',', '.')) || 0;
        }

        function populateQuantities(selectedValue) {
            const selectedProduct = productId.value;
            const prices = priceLookup[selectedProduct] ?? {};
            const quantities = Object.keys(prices)
                .map(Number)
                .sort((left, right) => left - right);

            quantity.innerHTML = '';

            if (quantities.length === 0) {
                quantity.disabled = true;
                quantity.append(new Option('Seleccione producto', ''));
                return;
            }

            quantity.disabled = false;

            for (const item of quantities) {
                quantity.append(new Option(item.toString(), item.toString()));
            }

            const preferredValue = selectedValue && prices[selectedValue] !== undefined
                ? selectedValue
                : quantities[0].toString();

            quantity.value = preferredValue;
        }

        function updateAmounts() {
            const selectedProduct = productId.value;
            const selectedQuantity = quantity.value;
            const paid = parseDecimal(paidAmount.value);
            const total = priceLookup[selectedProduct]?.[selectedQuantity] ?? 0;
            const commissionRate = commissionLookup[selectedProduct]?.[selectedQuantity] ?? 0;
            const purchaseUnitCost = costLookup[selectedProduct] ?? 0;
            const stock = stockLookup[selectedProduct] ?? 0;
            const commission = total * commissionRate / 100;
            const cost = purchaseUnitCost * Number(selectedQuantity || 0);
            const balance = Math.max(0, total - paid);
            const remaining = stock - Number(selectedQuantity || 0);

            productAmount.textContent = formatCurrency(total);
            commissionPreview.textContent = formatCurrency(commission);
            costPreview.textContent = formatCurrency(cost);
            stockPreview.textContent = stock.toString();
            paidPreview.textContent = formatCurrency(paid);
            balanceDue.textContent = formatCurrency(balance);

            if (selectedProduct && Number(selectedQuantity || 0) > 0 && remaining < 0) {
                stockWarning.textContent = `Aviso: este registro dejará el stock en ${remaining}.`;
                stockWarning.classList.remove('d-none');
            } else {
                stockWarning.textContent = '';
                stockWarning.classList.add('d-none');
            }
        }

        productId.addEventListener('change', () => {
            populateQuantities(quantity.value);
            updateAmounts();
        });
        quantity.addEventListener('change', updateAmounts);
        paidAmount.addEventListener('input', updateAmounts);

        document.querySelectorAll('.btn-proof-preview').forEach(btn => {
            btn.addEventListener('click', () => {
                const imageUrl = btn.dataset.url;
                document.getElementById('paymentProofPreview').src = imageUrl;
                document.getElementById('paymentProofOpenLink').href = imageUrl;

                const modal = new bootstrap.Modal(document.getElementById('paymentProofModal'));
                modal.show();
            });
        });

        populateQuantities(initialQuantity);
        updateAmounts();
    </script>
}
