@page
@model OldSchoolLab.Pages.Records.IndexModel
@{
    ViewData["Title"] = "Registros";
    int totalCols = 15 + (Model.CanEdit ? 1 : 0) + (Model.CanViewAudit ? 1 : 0) + (Model.CanDelete ? 1 : 0);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Registros</h1>
        <p class="text-muted mb-0">Mantenimiento del Excel en web.</p>
    </div>
    @if (Model.CanEdit)
    {
        <a asp-page="/Records/Create" class="btn btn-primary">Nuevo registro</a>
    }
</div>

<form method="get" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Estado</label>
                <div class="dropdown w-100">
                    <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="statusDropdownButton">
                        @if (Model.StatusIds.Count == 0)
                        {
                            <span>Todos</span>
                        }
                        else
                        {
                            <span>@Model.StatusIds.Count estado(s) seleccionado(s)</span>
                        }
                    </button>
                    <div class="dropdown-menu p-2 w-100" data-bs-auto-close="false" style="max-height: 420px; overflow-y: auto; min-width: 360px;">
                        @foreach (var status in Model.Statuses)
                        {
                            var isChecked = Model.StatusIds.Contains(status.Id);
                            <label class="dropdown-item d-flex align-items-center gap-2 px-3 py-2 mb-0" style="cursor: pointer;">
                                <input class="form-check-input js-status-filter m-0" type="checkbox" value="@status.Id" id="status-@status.Id" @(isChecked ? "checked" : null) />
                                <span>@status.Name</span>
                            </label>
                        }
                        <div class="dropdown-divider"></div>
                        <button type="button" class="btn btn-sm btn-outline-secondary w-100" id="clearStatuses">Limpiar</button>
                    </div>
                </div>
                @foreach (var statusId in Model.StatusIds)
                {
                    <input type="hidden" name="StatusIds" value="@statusId" class="status-hidden" />
                }
            </div>
            <div class="col-md-3">
                <label asp-for="Search" class="form-label">Buscar</label>
                <input asp-for="Search" class="form-control js-phone-search" placeholder="Celular, nombre, DNI o actividad" inputmode="tel" autocomplete="off" />
            </div>
            <div class="col-md-3">
                <label asp-for="FromDate" class="form-label">Fecha desde</label>
                <input asp-for="FromDate" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="ToDate" class="form-label">Fecha hasta</label>
                <input asp-for="ToDate" type="date" class="form-control" />
                <div class="mt-2">
                    <button type="button" class="btn btn-sm btn-outline-primary w-100" id="btnWholeMonth">Todo el mes</button>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex flex-wrap justify-content-end gap-2">
        <a asp-page="/Records/Index" class="btn btn-outline-secondary">Limpiar</a>
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        <button type="button" id="btnExportFiltered" class="btn btn-success">Exportar filtrados (.csv)</button>
        <button type="button" id="btnExportProspects" class="btn btn-warning">Exportar prospectos (.csv)</button>
    </div>
</form>

@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="border rounded p-3 bg-light h-100">
            <div class="text-muted small">Registros filtrados</div>
            <div class="fs-4 fw-semibold">@Model.TotalFilteredRecords</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="border rounded p-3 bg-light h-100">
            <div class="text-muted small">Suma de pagos</div>
            <div class="fs-4 fw-semibold text-success">@($"S/ {Model.TotalPaidAmount:0.00}")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="border rounded p-3 bg-light h-100">
            <div class="text-muted small">Suma por cobrar</div>
            <div class="fs-4 fw-semibold text-danger">@($"S/ {Model.TotalBalanceDue:0.00}")</div>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
            <tr>
                @if (Model.CanEdit)
                {
                    <th></th>
                }
                <th>Estado</th>
                <th>Fecha local</th>
                <th>Celular</th>
                <th>Nombre / Ref WA</th>
                <th>Actividad de la llamada</th>
                <th>DNI</th>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Valor</th>
                <th>Pagado</th>
                <th>Debe</th>
                <th>Pagos</th>
                <th>Últ. pago</th>
                <th>Ruta carpeta</th>
                <th>Usuario</th>
                @if (Model.CanViewAudit)
                {
                    <th></th>
                }
                @if (Model.CanDelete)
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
        @if (Model.Records.Count == 0)
        {
            <tr>
                <td colspan="@totalCols" class="text-center text-muted">No hay registros.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model.Records)
            {
                var rowStyle = item.StatusCatalog.Name == "Interesado" ? "background-color:#fff176 !important;" : "";
                <tr style="@rowStyle">
                    @if (Model.CanEdit)
                    {
                        <td>
                            <a asp-page="/Records/Edit"
                               asp-route-id="@item.Id"
                               asp-route-returnUrl="@($"{ViewContext.HttpContext.Request.Path}{ViewContext.HttpContext.Request.QueryString}")"
                               class="btn btn-sm btn-primary">Editar</a>
                        </td>
                    }
                    <td><span class="badge text-bg-@item.StatusCatalog.BadgeClass">@item.StatusCatalog.Name</span></td>
                    <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@item.Cellphone</td>
                    <td class="text-truncate" style="max-width:120px" title="@item.NameOrReference">@item.NameOrReference</td>
                    <td class="text-truncate" style="max-width:150px" title="@item.CallActivity">@item.CallActivity</td>
                    <td>@item.Dni</td>
                    <td>@item.Product?.Name</td>
                    <td>@item.Quantity</td>
                    <td class="text-nowrap">@($"S/ {item.ProductAmount:0.00}")</td>
                    <td class="text-nowrap">@($"S/ {item.ActivePaidAmount:0.00}")</td>
                    <td class="text-nowrap">@($"S/ {item.CalculatedBalanceDue:0.00}")</td>
                    <td>
                        <button type="button"
                                class="btn btn-sm btn-outline-info btn-payments"
                                data-id="@item.Id"
                                data-celular="@item.Cellphone"
                                title="Ver pagos en popup">
                            @item.Payments.Count(x => !x.IsReversed)
                        </button>
                    </td>
                    <td>@(item.Payments.Any(x => !x.IsReversed) ? item.Payments.Where(x => !x.IsReversed).Max(x => x.PaymentDate).ToString("yyyy-MM-dd") : "-")</td>
                    <td class="text-truncate" style="max-width:100px" title="@item.FolderPath">@item.FolderPath</td>
                    <td>
                        <div class="logistics-field-cell">
                            <div class="fw-bold text-uppercase small text-primary">Ruta carpeta</div>
                            <div class="text-break">@item.FolderPath</div>
                        </div>
                    </td>
                    <td>
                        <div class="logistics-field-cell">
                            <div class="fw-bold text-uppercase small text-primary">Destino</div>
                            <div class="text-break">@item.Destino</div>
                        </div>
                    </td>
                    <td>
                        <div class="logistics-field-cell">
                            <div class="fw-bold text-uppercase small text-primary">Clave</div>
                            <div class="text-break">@item.Clave</div>
                        </div>
                    </td>
                    <td>
                        <div class="logistics-field-cell">
                            <div class="fw-bold text-uppercase small text-primary">Guía</div>
                            <div class="text-break">@item.Guia</div>
                        </div>
                    </td>
                    <td>@item.CreatedByUserName</td>
                    @if (Model.CanViewAudit)
                    {
                        <td class="text-center">
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary btn-audit"
                                    data-id="@item.Id"
                                    data-celular="@item.Cellphone"
                                    title="Ver historial de cambios">
                                Auditor&iacute;a
                            </button>
                        </td>
                    }
                    @if (Model.CanDelete)
                    {
                        <td class="text-center">
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger btn-delete"
                                    data-id="@item.Id"
                                    data-celular="@item.Cellphone">
                                Eliminar
                            </button>
                        </td>
                    }
                </tr>
            }
        }
        </tbody>
    </table>
</div>

<div class="modal fade" id="paymentsModal" tabindex="-1" aria-labelledby="paymentsModalLabel" aria-hidden="true" data-bs-keyboard="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="paymentsModalLabel">Historial de pagos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="paymentsModalBody">
                <div class="text-center py-3">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="deleteModalLabel">Eliminar registro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Estás seguro de eliminar el registro de <strong id="deleteCelular"></strong>? Esta acción no se puede deshacer y se eliminarán todos los pagos asociados.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="paymentImageModal" tabindex="-1" aria-labelledby="paymentImageModalLabel" aria-hidden="true" data-bs-keyboard="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="paymentImageModalLabel">Comprobante</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="paymentImagePreview" src="" alt="Comprobante" class="img-fluid rounded" />
            </div>
            <div class="modal-footer">
                <a id="paymentImageOpenLink" href="#" target="_blank" rel="noopener" class="btn btn-outline-secondary">Abrir en pestaña</a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script>
document.querySelectorAll('.btn-delete').forEach(btn => {
    btn.addEventListener('click', () => {
        document.getElementById('deleteCelular').textContent = btn.dataset.celular;
        document.getElementById('deleteForm').action =
            `/Records?handler=Delete&id=${btn.dataset.id}`;
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    });
});

document.querySelectorAll('.btn-payments').forEach(btn => {
        btn.addEventListener('click', async () => {
            const id = btn.dataset.id;
            const celular = btn.dataset.celular;

            document.getElementById('paymentsModalLabel').textContent = `Pagos · Celular: ${celular}`;
            document.getElementById('paymentsModalBody').innerHTML =
                '<div class="text-center py-3"><div class="spinner-border text-primary" role="status"></div></div>';

            const modal = new bootstrap.Modal(document.getElementById('paymentsModal'));
            modal.show();

            try {
                const resp = await fetch(`/Records/Index?handler=Payments&id=${id}`);
                const payments = await resp.json();
                renderPayments(payments);
            } catch {
                document.getElementById('paymentsModalBody').innerHTML =
                    '<div class="alert alert-danger">Error al cargar los pagos.</div>';
            }
        });
    });

    function renderPayments(payments) {
        const body = document.getElementById('paymentsModalBody');

        if (!payments || payments.length === 0) {
            body.innerHTML = '<p class="text-muted text-center">Sin pagos registrados para este registro.</p>';
            return;
        }

        const rows = payments.map(payment => {
            const statusHtml = payment.isReversed
                ? `<div><span class="badge text-bg-danger">Extornado</span><div class="small text-muted mt-1">${payment.reversedByUserName ?? ''} ${payment.reversedAt ?? ''}</div></div>`
                : '<span class="badge text-bg-success">Activo</span>';

            const proofHtml = payment.proofImagePath
                ? `<button type="button" class="btn btn-sm btn-outline-secondary btn-payment-proof" data-url="${payment.proofImagePath}">Ver</button>`
                : '<span class="text-muted">Sin comprobante</span>';

            return `
                <tr>
                    <td>${payment.paymentDate}</td>
                    <td>${payment.createdAt}</td>
                    <td>S/ ${Number(payment.amount || 0).toFixed(2)}</td>
                    <td>${statusHtml}</td>
                    <td>${payment.createdByUserName ?? ''}</td>
                    <td>${proofHtml}</td>
                </tr>`;
        }).join('');

        body.innerHTML = `
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha pago</th>
                            <th>Registrado</th>
                            <th>Cod. operación</th>
                            <th>Monto</th>
                            <th>Estado</th>
                            <th>Usuario</th>
                            <th>Comprobante</th>
                        </tr>
                    </thead>
                    <tbody>${rows}</tbody>
                </table>
            </div>`;
    }

    document.getElementById('paymentsModalBody').addEventListener('click', event => {
        const button = event.target.closest('.btn-payment-proof');
        if (!button) {
            return;
        }

        const imageUrl = button.dataset.url;
        document.getElementById('paymentImagePreview').src = imageUrl;
        document.getElementById('paymentImageOpenLink').href = imageUrl;

        const modal = new bootstrap.Modal(document.getElementById('paymentImageModal'));
        modal.show();
    });
</script>

<script>
    document.querySelectorAll('.js-phone-search').forEach(input => {
        input.addEventListener('paste', event => {
            const text = (event.clipboardData || window.clipboardData).getData('text');
            if (!text) {
                return;
            }

            const normalized = text.trim().replace(/\s+/g, '').replace(/^\+51/, '');
            if (!/^\d+$/.test(normalized)) {
                return;
            }

            event.preventDefault();
            input.value = normalized;
            input.dispatchEvent(new Event('input', { bubbles: true }));
        });
    });
</script>

<script>
    const btnWholeMonth = document.getElementById('btnWholeMonth');
    if (btnWholeMonth) {
        btnWholeMonth.addEventListener('click', () => {
            const fromDate = document.getElementById('FromDate');
            const toDate = document.getElementById('ToDate');
            const today = new Date();
            const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
            const lastDay = new Date(today.getFullYear(), today.getMonth() + 1, 0);

            const formatDate = date => date.toISOString().slice(0, 10);
            fromDate.value = formatDate(firstDay);
            toDate.value = formatDate(lastDay);
            document.querySelector('form[method="get"]').submit();
        });
    }
</script>

<script>
    const statusDropdownButton = document.getElementById('statusDropdownButton');
    const clearStatuses = document.getElementById('clearStatuses');
    const filtersForm = document.querySelector('form[method="get"]');

    function syncStatusHiddenInputs() {
        document.querySelectorAll('.status-hidden').forEach(x => x.remove());

        const selectedIds = Array.from(document.querySelectorAll('.js-status-filter:checked')).map(x => x.value);
        for (const id of selectedIds) {
            const hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = 'StatusIds';
            hidden.value = id;
            hidden.className = 'status-hidden';
            filtersForm.appendChild(hidden);
        }

        if (statusDropdownButton) {
            statusDropdownButton.querySelector('span').textContent = selectedIds.length === 0
                ? 'Todos'
                : `${selectedIds.length} estado(s) seleccionado(s)`;
        }
    }

    document.querySelectorAll('.js-status-filter').forEach(checkbox => {
        checkbox.addEventListener('change', syncStatusHiddenInputs);
        checkbox.addEventListener('click', event => event.stopPropagation());
    });

    if (clearStatuses) {
        clearStatuses.addEventListener('click', () => {
            document.querySelectorAll('.js-status-filter').forEach(checkbox => checkbox.checked = false);
            syncStatusHiddenInputs();
        });
    }

    syncStatusHiddenInputs();
</script>

@if (Model.CanViewAudit)
{
    <div class="modal fade" id="auditModal" tabindex="-1" aria-labelledby="auditModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="auditModalLabel">Historial de cambios</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="auditModalBody">
                    <div class="text-center py-3">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            function buildExportUrl(handler) {
                var form = document.querySelector('form[method="get"]');
                var params = new URLSearchParams();
                params.set('handler', handler);
                form.querySelectorAll('select, input').forEach(function (el) {
                    if (el.name && el.value) params.set(el.name, el.value);
                });
                return '/Records?' + params.toString();
            }

            var btnFiltered = document.getElementById('btnExportFiltered');
            if (btnFiltered) {
                btnFiltered.addEventListener('click', function () {
                    window.location.href = buildExportUrl('ExportFiltered');
                });
            }

            var btnProspects = document.getElementById('btnExportProspects');
            if (btnProspects) {
                btnProspects.addEventListener('click', function () {
                    window.location.href = buildExportUrl('ExportProspects');
                });
            }
        })();

        document.querySelectorAll('.btn-audit').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.dataset.id;
                const celular = btn.dataset.celular;

                document.getElementById('auditModalLabel').textContent = `Historial · Celular: ${celular}`;
                document.getElementById('auditModalBody').innerHTML =
                    '<div class="text-center py-3"><div class="spinner-border text-primary" role="status"></div></div>';

                const modal = new bootstrap.Modal(document.getElementById('auditModal'));
                modal.show();

                try {
                    const resp = await fetch(`/Records/Index?handler=Audit&id=${id}`);
                    const logs = await resp.json();
                    renderAudit(logs);
                } catch {
                    document.getElementById('auditModalBody').innerHTML =
                        '<div class="alert alert-danger">Error al cargar el historial.</div>';
                }
            });
        });

        function renderAudit(logs) {
            const body = document.getElementById('auditModalBody');

            if (!logs || logs.length === 0) {
                body.innerHTML = '<p class="text-muted text-center">Sin historial de cambios para este registro.</p>';
                return;
            }

            let html = '';
            for (const log of logs) {
                const badgeColor = log.action === 'Creado' ? 'success' : 'warning';
                html += `
                    <div class="border rounded p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span>
                                <span class="badge text-bg-${badgeColor} me-2">${log.action}</span>
                                <strong>${log.changedByUserName}</strong>
                            </span>
                            <span class="text-muted small">${log.changedAt}</span>
                        </div>
                        ${renderDetails(log.details)}
                    </div>`;
            }

            body.innerHTML = html;
        }

        function renderDetails(details) {
            if (!details) return '';

            try {
                const data = JSON.parse(details);

                if (typeof data !== 'object' || Array.isArray(data)) {
                    return `<pre class="bg-light p-2 rounded small">${JSON.stringify(data, null, 2)}</pre>`;
                }

                let rows = '';
                for (const [key, value] of Object.entries(data)) {
                    rows += `<tr><td class="fw-semibold text-nowrap">${key}</td><td>${value ?? ''}</td></tr>`;
                }

                return `<table class="table table-sm table-bordered mb-0"><tbody>${rows}</tbody></table>`;
            } catch {
                return `<pre class="bg-light p-2 rounded small">${details}</pre>`;
            }
        }
    </script>
}

