@page
@model OldSchoolLab.Pages.Admin.Inventory.IndexModel
@{
    ViewData["Title"] = "Inventario";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Inventario</h1>
        <p class="text-muted mb-0">Stock = ingresos - salidas.</p>
    </div>
</div>

@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <h2 class="h5">Registrar stock</h2>
        <form method="post" asp-page-handler="AddMovement" class="row g-3">
            <div class="col-md-4">
                <label class="form-label" asp-for="MovementProductId">Producto</label>
                <select class="form-select" asp-for="MovementProductId">
                    <option value="">Seleccione...</option>
                    @foreach (var product in Model.Products)
                    {
                        <option value="@product.Id">@product.Name</option>
                    }
                </select>
                <span class="text-danger small" asp-validation-for="MovementProductId"></span>
            </div>
            <div class="col-md-2">
                <label class="form-label" asp-for="MovementType">Tipo</label>
                <select class="form-select" asp-for="MovementType">
                    <option value="Ingreso">Ingreso</option>
                    <option value="Egreso">Salida</option>
                </select>
                <span class="text-danger small" asp-validation-for="MovementType"></span>
            </div>
            <div class="col-md-2">
                <label class="form-label" asp-for="MovementQuantity">Cantidad</label>
                <input class="form-control" asp-for="MovementQuantity" />
                <span class="text-danger small" asp-validation-for="MovementQuantity"></span>
            </div>
            <div class="col-md-2">
                <label class="form-label" asp-for="MovementUnitCost">Costo unitario</label>
                <input class="form-control" asp-for="MovementUnitCost" />
                <span class="text-danger small" asp-validation-for="MovementUnitCost"></span>
            </div>
            <div class="col-md-2">
                <label class="form-label" asp-for="MovementDate">Fecha</label>
                <input class="form-control" asp-for="MovementDate" type="date" />
            </div>
            <div class="col-12">
                <label class="form-label" asp-for="MovementNotes">Notas</label>
                <textarea class="form-control" asp-for="MovementNotes" rows="2"></textarea>
                <span class="text-danger small" asp-validation-for="MovementNotes"></span>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">Guardar movimiento</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Productos</div>
                <div class="fs-3 fw-semibold">@Model.TotalProducts</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Unidades en stock</div>
                <div class="fs-3 fw-semibold">@Model.TotalUnits</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Valor estimado</div>
                <div class="fs-3 fw-semibold">S/ @Model.TotalValue.ToString("0.00")</div>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-light">
            <tr>
                <th>Producto</th>
                <th>Estado</th>
                <th class="text-end">Stock</th>
                <th class="text-end">Costo unitario</th>
                <th class="text-end">Valor estimado</th>
                <th>Último movimiento</th>
                <th class="text-end">Movimientos</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td class="fw-semibold">@item.ProductName</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge text-bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">@item.Stock</td>
                    <td class="text-end">S/ @item.PurchaseUnitCost.ToString("0.00")</td>
                    <td class="text-end">S/ @item.TotalValue.ToString("0.00")</td>
                    <td>
                        @if (item.LastMovementDate.HasValue)
                        {
                            <span>@item.LastMovementType</span>
                            <div class="text-muted small">@item.LastMovementDate.Value.ToString("yyyy-MM-dd")</div>
                        }
                        else
                        {
                            <span class="text-muted">Sin movimientos</span>
                        }
                    </td>
                    <td class="text-end">@item.MovementCount</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-body">
        <h2 class="h5 mb-3">Movimientos recientes</h2>
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Producto</th>
                        <th>Tipo</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Costo unitario</th>
                        <th class="text-end">Total</th>
                        <th>Notas</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var movement in Model.RecentMovements)
                    {
                        <tr>
                            <td>@movement.MovementDate.ToString("yyyy-MM-dd")</td>
                            <td>@movement.ProductName</td>
                            <td>
                                <span class="badge @((string.Equals(movement.MovementType, "Salida", StringComparison.OrdinalIgnoreCase) || string.Equals(movement.MovementType, "Egreso", StringComparison.OrdinalIgnoreCase)) ? "text-bg-danger" : "text-bg-success")">
                                    @movement.MovementType
                                </span>
                            </td>
                            <td class="text-end">@movement.Quantity</td>
                            <td class="text-end">S/ @movement.UnitCost.ToString("0.00")</td>
                            <td class="text-end">S/ @movement.TotalCost.ToString("0.00")</td>
                            <td>@movement.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
