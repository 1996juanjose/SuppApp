@page
@model OldSchoolLab.Pages.Admin.Profit.IndexModel
@{
    ViewData["Title"] = "Ganancias";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Ganancias</h1>
        <p class="text-muted mb-0">Calculado por rango de fechas: pagos - comisiones - costo del producto - gastos extra.</p>
    </div>
</div>

@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<form method="get" class="card shadow-sm mb-3">
    <div class="card-body row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="FromDate">Desde</label>
            <input class="form-control" id="FromDate" name="FromDate" type="date" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="ToDate">Hasta</label>
            <input class="form-control" id="ToDate" name="ToDate" type="date" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">Filtrar</button>
        </div>
    </div>
</form>

<div class="row g-3 mb-3">
    <div class="col-md-2">
        <div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Pagos</div><div class="fs-5 fw-semibold">S/ @Model.TotalPaidAmount.ToString("0.00")</div></div></div>
    </div>
    <div class="col-md-2">
        <div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Comisiones</div><div class="fs-5 fw-semibold">S/ @Model.TotalCommissionAmount.ToString("0.00")</div></div></div>
    </div>
    <div class="col-md-2">
        <div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Costo producto</div><div class="fs-5 fw-semibold">S/ @Model.TotalProductCost.ToString("0.00")</div></div></div>
    </div>
    <div class="col-md-2">
        <div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Ganancia bruta</div><div class="fs-5 fw-semibold">S/ @Model.GrossProfit.ToString("0.00")</div></div></div>
    </div>
    <div class="col-md-2">
        <div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Otros gastos</div><div class="fs-5 fw-semibold">S/ @Model.TotalOtherExpenses.ToString("0.00")</div></div></div>
    </div>
    <div class="col-md-2">
        <div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Ganancia neta</div><div class="fs-5 fw-semibold">S/ @Model.NetProfit.ToString("0.00")</div></div></div>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <h2 class="h5">Agregar gasto opcional</h2>
        <form method="post" asp-page-handler="AddExpense" class="row g-3">
            <input type="hidden" name="FromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="ToDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
            <div class="col-md-3">
                <label class="form-label" asp-for="ExpenseDate">Fecha</label>
                <input class="form-control" asp-for="ExpenseDate" type="date" />
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="ExpenseName">Nombre</label>
                <input class="form-control" asp-for="ExpenseName" />
                <span class="text-danger small" asp-validation-for="ExpenseName"></span>
            </div>
            <div class="col-md-2">
                <label class="form-label" asp-for="ExpenseAmount">Costo</label>
                <input class="form-control" asp-for="ExpenseAmount" />
                <span class="text-danger small" asp-validation-for="ExpenseAmount"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="ExpenseNotes">Notas</label>
                <input class="form-control" asp-for="ExpenseNotes" />
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-outline-primary">Guardar gasto</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">Registros del rango</h2>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Celular</th>
                                <th>Producto</th>
                                <th class="text-end">Pagado</th>
                                <th class="text-end">Comisión</th>
                                <th class="text-end">Costo</th>
                                <th class="text-end">Ganancia</th>
                                <th class="text-end">Saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Records)
                            {
                                <tr>
                                    <td>@item.RecordDate.ToString("yyyy-MM-dd")</td>
                                    <td>@item.Cellphone</td>
                                    <td>@item.ProductName</td>
                                    <td class="text-end">S/ @item.PaidAmount.ToString("0.00")</td>
                                    <td class="text-end">S/ @item.CommissionAmount.ToString("0.00")</td>
                                    <td class="text-end">S/ @item.ProductCost.ToString("0.00")</td>
                                    <td class="text-end">S/ @item.Profit.ToString("0.00")</td>
                                    <td class="text-end">S/ @item.BalanceDue.ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">Gastos extra del rango</h2>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Nombre</th>
                                <th class="text-end">Costo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Expenses)
                            {
                                <tr>
                                    <td>@item.ExpenseDate.ToString("yyyy-MM-dd")</td>
                                    <td>@item.Name</td>
                                    <td class="text-end">S/ @item.Amount.ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
