@page
@model OldSchoolLab.Pages.Chat.IndexModel
@{
    ViewData["Title"] = "Chat";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm mt-4">
            <div class="card-body">
                <h1 class="h4 mb-4">Chat</h1>

                <form method="post" asp-page-handler="Load" class="row g-3 mb-4">
                    <div class="col-md-8">
                        <label asp-for="PhoneNumber" class="form-label">Teléfono</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="51987654321" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-outline-primary w-100">Cargar conversación</button>
                    </div>
                </form>

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-warning">@Model.ErrorMessage</div>
                }

                @if (Model.ThreadData?.Messages?.Any() == true)
                {
                    <div class="border rounded p-3 mb-4 bg-light" style="max-height: 420px; overflow-y: auto;">
                        @foreach (var message in Model.ThreadData.Messages.OrderBy(x => x.CreatedAt))
                        {
                            var isOutgoing = message.Direction == 1;
                            <div class="d-flex mb-2 @(isOutgoing ? "justify-content-end" : "justify-content-start")">
                                <div class="p-2 rounded-3 @(isOutgoing ? "bg-primary text-white" : "bg-white border")" style="max-width: 75%;">
                                    <div class="small opacity-75">@message.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                    <div>@message.MessageText</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (string.IsNullOrWhiteSpace(Model.ErrorMessage) == false)
                {
                    <div class="text-muted mb-4">No hay mensajes para mostrar.</div>
                }

                <form method="post" asp-page-handler="Send" class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="MessageText" class="form-label">Mensaje</label>
                        <textarea asp-for="MessageText" class="form-control" rows="3" placeholder="Escribe aquí el mensaje..."></textarea>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Enviar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
