{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "OldSchool.AuthService",
    "Audience": "OldSchool.Microservices",
    "Key": "TU_CLAVE_SUPER_SECRETA_CAMBIAR_EN_PRODUCCION_1234567890",
    "ExpiryMinutes": 120
  },
  "ReverseProxy": {
    "Routes": {
      "chat-route": {
        "ClusterId": "chat-cluster",
        "Match": {
          "Path": "/chat/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/chat"
          }
        ]
      }
    },
    "Clusters": {
      "chat-cluster": {
        "Destinations": {
          "chat-destination": {
            "Address": "https://localhost:64391/api/chat/"
          }
        }
      }
    }
  }
}
