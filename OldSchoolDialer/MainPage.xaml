<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="OldSchoolDialer.MainPage" Title="OldSchool · Llamadas" BackgroundColor="#F5F7FB">
 <ScrollView><VerticalStackLayout Padding="20,28" Spacing="16">
  <Border x:Name="LoginPanel" Stroke="#E2E8F0" BackgroundColor="White" Padding="18" StrokeShape="RoundRectangle 14">
   <VerticalStackLayout Spacing="12">
    <Label Text="Iniciar sesión" FontSize="18" FontAttributes="Bold"/>
    <Button x:Name="CompaniesButton" Text="Reintentar conexión" IsVisible="False" Clicked="OnCompaniesClicked"/>
    <Label Text="Empresa" FontSize="12" TextColor="#64748B"/>
    <Picker x:Name="CompanyPicker" Title="Selecciona tu empresa" ItemDisplayBinding="{Binding Name}"/>
    <Entry x:Name="UsernameEntry" Placeholder="Usuario" ReturnType="Next"/>
    <Entry x:Name="PasswordEntry" Placeholder="Contraseña" IsPassword="True"/>
    <Button x:Name="LoginButton" Text="Iniciar sesión" Clicked="OnLoginClicked" BackgroundColor="#2563EB" TextColor="White"/>
   </VerticalStackLayout>
  </Border>
  <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False" Color="#2563EB"/>
  <Label x:Name="MessageLabel" TextColor="#BE123C" FontSize="13"/>
  <VerticalStackLayout x:Name="QueuePanel" IsVisible="False" Spacing="16">
   <Border Stroke="#BFDBFE" BackgroundColor="#EFF6FF" Padding="16" StrokeShape="RoundRectangle 14"><VerticalStackLayout Spacing="8"><Label Text="Progreso del recorrido" FontAttributes="Bold"/><Label x:Name="QueueSummaryLabel" FontSize="17" TextColor="#172338"/><ProgressBar x:Name="QueueProgressBar" ProgressColor="#059669"/></VerticalStackLayout></Border>
   <Grid ColumnDefinitions="*,Auto"><Label x:Name="SessionLabel" VerticalOptions="Center" FontAttributes="Bold"/><Button Grid.Column="1" Text="Salir" Clicked="OnLogoutClicked" BackgroundColor="#E2E8F0" TextColor="#475569"/></Grid>
   <Border Stroke="#E2E8F0" BackgroundColor="White" Padding="16" StrokeShape="RoundRectangle 14"><VerticalStackLayout Spacing="10">
    <HorizontalStackLayout Spacing="8"><CheckBox x:Name="DatesCheck"/><Label Text="Filtrar por fecha de creación" VerticalOptions="Center"/></HorizontalStackLayout>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><DatePicker x:Name="FromPicker" Format="dd/MM/yyyy"/><DatePicker x:Name="ToPicker" Grid.Column="1" Format="dd/MM/yyyy"/></Grid>
    <Label Text="Canal de llamada" FontSize="12" FontAttributes="Bold"/>
    <Picker x:Name="ChannelPicker" Title="Cómo contactar"/>
    <Label x:Name="ChannelHintLabel" FontSize="12" TextColor="#64748B"/>
    <Picker x:Name="BatchPicker" Title="Tamaño de la tanda"/>
    <Button x:Name="LoadButton" Text="Aplicar filtros y cargar" Clicked="OnLoadQueueClicked"/>
   </VerticalStackLayout></Border>
   <Border Stroke="#BFDBFE" BackgroundColor="#EFF6FF" Padding="16" StrokeShape="RoundRectangle 14"><VerticalStackLayout Spacing="10">
    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label x:Name="LockLabel" Text="🔓 Avance manual" FontAttributes="Bold"/><Label Text="Puedes guardar y llamar al siguiente con el botón azul." FontSize="11" TextColor="#64748B"/></VerticalStackLayout><Switch x:Name="AutomaticSwitch" Grid.Column="1" OnColor="#2563EB" Toggled="OnAutomaticToggled"/></Grid>
    <Button x:Name="StartButton" Text="Iniciar llamadas masivas" Clicked="OnStartClicked" BackgroundColor="#2563EB"/>
   </VerticalStackLayout></Border>

   <VerticalStackLayout x:Name="CallWorkspace" Spacing="12">
   <Border Stroke="#BFDBFE" BackgroundColor="#EFF6FF" Padding="16" StrokeShape="RoundRectangle 14"><VerticalStackLayout Spacing="8"><Label Text="Progreso del recorrido" FontAttributes="Bold"/><Label x:Name="CallProgressLabel" FontSize="17" TextColor="#172338"/><ProgressBar x:Name="CallProgressBar" ProgressColor="#059669"/></VerticalStackLayout></Border>
   <ActivityIndicator x:Name="CallBusyIndicator" IsVisible="False" IsRunning="False" Color="#2563EB"/>
   <Label x:Name="CallMessageLabel" FontSize="13" TextColor="#047857"/>

   <Border x:Name="CurrentProspectPanel" IsVisible="False" Stroke="#E2E8F0" BackgroundColor="White" Padding="20" StrokeShape="RoundRectangle 14"><VerticalStackLayout Spacing="14">
    <Label x:Name="ProspectPositionLabel" TextColor="#64748B" FontSize="11"/>
    <Label x:Name="ProspectNameLabel" FontSize="23" FontAttributes="Bold"/>
    <Label x:Name="ProspectPhoneLabel" FontSize="24" TextColor="#2563EB"/>
    <Label x:Name="CallCountLabel" FontAttributes="Bold" TextColor="#7C3AED"/>
    <Label x:Name="PreviousOutcomeLabel" FontSize="12" TextColor="#64748B"/>
    <Label Text="1. Selecciona el resultado de la llamada" FontAttributes="Bold"/>
    <FlexLayout x:Name="OutcomeChoices" Wrap="Wrap">
     <Button Text="Contestó" CommandParameter="Contestó" Clicked="OnOutcomeSelected" BackgroundColor="#E2E8F0" TextColor="#334155" Margin="0,0,6,6"/>
     <Button x:Name="NoAnswerButton" Text="No contestó (1 vez)" CommandParameter="No contestó" Clicked="OnOutcomeSelected" BackgroundColor="#E2E8F0" TextColor="#334155" Margin="0,0,6,6"/>
     <Button Text="Competencia" CommandParameter="Competencia" Clicked="OnOutcomeSelected" BackgroundColor="#E2E8F0" TextColor="#334155" Margin="0,0,6,6"/>
     <Button Text="No interesado" CommandParameter="No interesado" Clicked="OnOutcomeSelected" BackgroundColor="#E2E8F0" TextColor="#334155" Margin="0,0,6,6"/>
    </FlexLayout>
    <Label x:Name="SelectedOutcomeLabel" Text="Elige una opción para habilitar el guardado." TextColor="#64748B" FontSize="12"/>
    <Picker x:Name="OutcomePicker" IsVisible="False" Title="Resultado" SelectedIndexChanged="OnOutcomeChanged"/>

    <VerticalStackLayout x:Name="CallbackPanel" IsVisible="False"><Label Text="Volver a llamar (hora de Perú)" FontSize="12"/><DatePicker x:Name="CallbackDate"/><TimePicker x:Name="CallbackTime" Format="HH:mm"/></VerticalStackLayout>
    <Editor x:Name="NotesEditor" Placeholder="Notas opcionales" AutoSize="TextChanges" MaxLength="250"/>
    <Button x:Name="SaveResultButton" Text="Guardar y llamar al siguiente" Clicked="OnSaveResultClicked" BackgroundColor="#2563EB"/>
    <Button x:Name="SkipButton" Text="Omitir y seguir" Clicked="OnSkipClicked" BackgroundColor="#E2E8F0" TextColor="#334155"/>
    <Label Text="Omitir pasa al siguiente sin registrar un intento ni un resultado." FontSize="11" TextColor="#64748B"/>
   </VerticalStackLayout></Border>
   </VerticalStackLayout>
  </VerticalStackLayout>
 </VerticalStackLayout></ScrollView>
</ContentPage>
